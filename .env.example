# HTTP server
PORT=8080
ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable

# Auth
JWT_SECRET=please-change-this-to-a-long-random-secret
JWT_TTL_HOURS=24

# Comma-separated list of allowed CORS origins (dashboard + public site)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
