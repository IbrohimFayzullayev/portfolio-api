# =====================================================================
#  Production environment for the VPS. Copy to `.env` on the server and
#  fill in real values. NEVER commit the real `.env`.
#    cp .env.prod.example .env && nano .env
# =====================================================================

# ---- Domains (must have DNS A records pointing to this server) ----
PUBLIC_DOMAIN=example.com
DASHBOARD_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
STATS_DOMAIN=stats.example.com

# ---- Container registry (lowercase GitHub owner) + image tag ----
REGISTRY=ghcr.io/ibrohimfayzullayev
TAG=latest

# ---- PostgreSQL ----
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_password
POSTGRES_DB=portfolio

# ---- Go API ----
# Host is the compose service name `db`; password must match POSTGRES_PASSWORD.
DATABASE_URL=postgres://portfolio:CHANGE_ME_to_a_long_random_password@db:5432/portfolio?sslmode=disable
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_at_least_32_chars
JWT_TTL_HOURS=24
# Browser origins allowed to call the API. Only the dashboard needs this: the
# public site reaches the API from its server, not from the visitor's browser.
# The dashboard session is a cookie, and a request that changes anything is
# only accepted from an origin listed here — so keep this list as short as it
# can be.
CORS_ORIGINS=https://admin.example.com

# ---- Telegram ops bot ----
# Token: @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id: @userinfobot -> /start.
# The bot reads the database, so it answers ONLY this id and ignores everyone
# else without replying.
# Bitta ID yoki vergul bilan ajratilgan ro'yxat. BIRINCHISI — xabarlar
# yuboriladigan hisob; qolganlari faqat buyruq bera oladi.
TELEGRAM_ALLOWED_USER_ID=

# ---- Umami analytics ----
# Its own database on the same Postgres container. Create it once:
#   docker compose -f docker-compose.prod.yml exec -T db \
#     psql -U portfolio -c "CREATE DATABASE umami OWNER portfolio;"
UMAMI_DATABASE_URL=postgresql://portfolio:CHANGE_ME_to_a_long_random_password@db:5432/umami
# openssl rand -hex 32
UMAMI_APP_SECRET=CHANGE_ME_to_a_long_random_secret_at_least_32_chars
# Exactly 64 hex characters: openssl rand -hex 32
UMAMI_2FA_KEY=CHANGE_ME_to_exactly_64_hex_characters

# --- Bot → Umami (ixtiyoriy) ---
# Bo'sh qoldirilsa bot trafik bo'limini umuman chiqarmaydi — nol ko'rsatmaydi.
# UMAMI_WEBSITE_ID — Umami'dagi sayt ID si (NEXT_PUBLIC_UMAMI_WEBSITE_ID bilan bir xil).
# Autentifikatsiya: yo API kalit, yo login/parol.
UMAMI_WEBSITE_ID=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_API_KEY=

# --- Tashqi heartbeat (ixtiyoriy, tavsiya etiladi) ---
# healthchecks.io kabi xizmatdagi tekshiruv URL'i. Bot har 2 daqiqada unga
# GET yuboradi; pinglar to'xtasa (server o'chgan bo'lsa ham) o'sha xizmat
# ogohlantiradi.
HEARTBEAT_PING_URL=

# ---- Finance bot (cmd/finbot) ----
# A separate Telegram bot for other people's money logs - NOT the ops bot.
# Token: @BotFather -> /newbot (a new bot, not TELEGRAM_BOT_TOKEN).
# Empty = the finbot container idles and does nothing.
FINBOT_TOKEN=
# Your Telegram id: you approve people and make invite links (/taklif).
FINBOT_ADMIN_ID=
# Its Mini App lives here (DNS A record -> this server, like the others).
FINBOT_DOMAIN=hisob.example.com
# Its own database on the same Postgres, created by the bot on first start.
# FINBOT_DB=finbot
# Shared by the api and finbot containers: the dashboard's "Moliya boti"
# pages go dashboard -> api (admin session) -> finbot (this key).
# openssl rand -hex 32
FINBOT_ADMIN_KEY=
# true: you see users' amounts and reports in the dashboard (they are told).
# false: only who uses the bot and how often.
FINBOT_ADMIN_SEES_MONEY=true

# ---- Backups (deploy/cron/backup.sh) ----
# Off-site copy of the nightly dump. Empty = local only. An rclone destination;
# see deploy/cron/README.md.
BACKUP_REMOTE=
# Databases dumped beside $POSTGRES_DB, one file each. Default: finbot.
# BACKUP_EXTRA_DATABASES=finbot
