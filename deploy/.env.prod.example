# =====================================================================
#  Production environment for the VPS. Copy to `.env` on the server and
#  fill in real values. NEVER commit the real `.env`.
#    cp .env.prod.example .env && nano .env
# =====================================================================

# ---- Domains (must have DNS A records pointing to this server) ----
PUBLIC_DOMAIN=example.com
DASHBOARD_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# ---- Container registry (lowercase GitHub owner) + image tag ----
REGISTRY=ghcr.io/ibrohimfayzullayev
TAG=latest

# ---- PostgreSQL ----
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_password
POSTGRES_DB=portfolio

# ---- Go API ----
# Host is the compose service name `db`; password must match POSTGRES_PASSWORD.
DATABASE_URL=postgres://portfolio:CHANGE_ME_to_a_long_random_password@db:5432/portfolio?sslmode=disable
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_at_least_32_chars
JWT_TTL_HOURS=24
# Browser origins allowed to call the API (the dashboard + the public site).
CORS_ORIGINS=https://exclusive-invitation-for-aziza.vercel.app/
